{
  "name": "dayparty-api",
  "version": "1.0.0",
  "description": "Day Party API - Democratic discussion and voting platform",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc && npx prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:update-enum": "tsx scripts/update-enum.ts",
    "db:update-enum-delta": "tsx scripts/update-enum-delta.ts",
    "admin:set": "tsx scripts/set-admin.ts",
    "import:proposals": "tsx scripts/import-proposals.ts",
    "import:comments": "tsx scripts/import-comments.ts",
    "import:knesset-bills": "tsx scripts/import-knesset-bills.ts",
    "import:knesset-bills-sqlite": "tsx scripts/import-knesset-bills-from-sqlite.ts",
    "import:memes": "tsx scripts/import-memes.ts",
    "create:memes-topic": "tsx scripts/create-memes-topic.ts",
    "cleanup:imported": "tsx scripts/cleanup-imported-threads.ts"
