# Database
DATABASE_URL="mysql://username:password@localhost:3306/dayparty"

# JWT Secret (generate a secure random string in production)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server Configuration
PORT=3000
NODE_ENV="development"

# Google OAuth (for social login)
GOOGLE_CLIENT_ID="558688125322-d6hau7lcr0rj1cjmjif7eiefpvvglqvb.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# Facebook OAuth (optional)
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"

# CORS
CORS_ORIGIN="http://localhost:8080"

# Google Drive (for video storage)
# Option 1: Service Account (recommended for production)
# Download JSON key from Google Cloud Console and paste as single-line JSON
GOOGLE_DRIVE_CREDENTIALS=""

# Option 2: OAuth2 (for personal Drive - requires refresh token)
# Get these from Google Cloud Console > APIs & Services > Credentials
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""

# Optional: Folder ID in Google Drive to organize videos
# Leave empty to upload to Drive root
GOOGLE_DRIVE_FOLDER_ID=""

